# Binaries
compartment-user
compartment-root
tests/probes/deny_probe

# Build artifacts
*.o
*.d
*.a
*.so
# ...but not the rootless test suites: "*.d" above matches the directory
# name tests/scripts/rootless.d, and git will not descend into an excluded
# directory, so the directory itself has to be re-included.
!tests/scripts/rootless.d/

# Generated headers (config.py output)
config.h
compartment-root-config.h

# Core dumps
core
core.*
vgcore.*

# Test output
tests/output/

# Review / analysis artifacts
review-isolation-tools.md
vs-*.md

# Archive (tracked on archive/* branches, not main)
archive/

# Editor
*.swp
*~
.vscode/
